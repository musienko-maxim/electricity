# Iter2 (multi-PDF): index page that lists all 12 outage-queue PDFs.
# discover.ts scrapes this page on each bootstrap to find current URLs, so the
# app self-heals when upstream rotates the per-publication UUIDs.
CHERKASY_INDEX_URL=https://www.cherkasyoblenergo.com/static/perelik-gpv

# Iter1 single-PDF mode (still supported as a fallback / dev override).
# If CHERKASY_INDEX_URL is set, discovered URLs win; this one is appended only
# if it isn't already in the discovered set.
# CHERKASY_SAMPLE_PDF_URL=https://gita.cherkasyoblenergo.com/obl-main-controller/file/obl_main_static_172_83e8c1e1-e30a-491e-a7ad-8d30f914863a.pdf

# Where to store SQLite + cached PDFs. Defaults to ./data when unset.
DATA_DIR=./data
